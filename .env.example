# ==============================================================================
# CGBGEAR_SERVER 环境配置文件示例 (.env.example)
# 请复制此文件为 .env 并按实际部署环境填写相应配置参数。
# 注意：切勿将包含真实凭据的 .env 文件提交到任何代码仓库中！
# ==============================================================================

# --- JWT 认证安全配置 ---
# 用于签名身份令牌，请使用长度足够且不可猜测的随机高强度字符串
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_EXP_MINUTES=15

# --- 数据库配置 (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cgbgear_user
DB_PASSWORD=your_db_password_here
DB_NAME=cgbgear_db

# --- Redis 缓存与限流配置 ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_optional

# --- 域名与跨域服务配置 ---
FRONTEND_BASE_URL=https://cgbgear.cn
IMAGE_SERVER_BASE_URL=https://img.cgbgear.cn

# --- SMTP 邮件发送配置 ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_smtp_auth_password
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=CGBGEAR
SMTP_USE_SSL=0

# --- 外部服务 / AI API ---
deepseek_api_key=your_deepseek_api_key_here
